# Copie para .env.local e preencha. Valores PUBLICOS (vao embutidos no app).
# Nunca coloque aqui a senha do banco nem a secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ID do cliente OAuth "Aplicativo da Web" do Google Cloud (publico)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Link do ultimo APK de teste (botao em Configuracoes > Desenvolvimento). Muda a cada build:
# atualize aqui e no EAS (eas env:set, ambientes preview e development). Ver docs/DESENVOLVIMENTO.md
EXPO_PUBLIC_DEV_APK_URL=
